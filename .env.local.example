# 手元の既定（.env.local）。手元の Supabase（supabase start）に向ける。
# コンテナの中から届くよう host.docker.internal を使う。ポートは Supabase CLI の既定（API 54321・DB 54322）。
# 下の値は CLI の既定の値で秘密ではない。

# 手元の Supabase の DB
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# 手元の Supabase の API（Auth の JWT 検証に使う）。DATABASE_URL と同じ側（手元）にそろえる
SUPABASE_URL=http://host.docker.internal:54321

# CDN の失効。空なら呼ばない（手元の既定は空）
CDN_DISTRIBUTION_ID=

# socket の serverless-offline（npm run dev:host）に合図を送る。消せば合図は送らない
SOCKET_BROADCAST_FUNCTION_NAME=sotetsu-lab-v3-dev-socket-broadcast-lambda
SOCKET_BROADCAST_LAMBDA_ENDPOINT=http://host.docker.internal:3022

# COGNITO_* は使っていないので書かない
