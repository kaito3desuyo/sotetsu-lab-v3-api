# 本番を手元から見るとき用（.env.local.prod）。
# npm run migration:show:prod / migration:run:prod / start:dev:prod が読む。
# 本番の DB へは Lambda の外からは読み取り専用でつながる（書けるのは migration:run:prod だけ）。
# 値は <...> のところに本番の値を入れる。秘密なのでコミットしない。

# 本番の Supabase の DB（接続文字列。パスワードを含む）
DATABASE_URL=<postgresql://...supabase.com...>

# 本番の Supabase の API（https://<project ref>.supabase.co）。DATABASE_URL と同じ側（本番）にそろえる
SUPABASE_URL=<https://....supabase.co>

# CDN の失効。本番を見るだけなので空のままにする
CDN_DISTRIBUTION_ID=

# socket への合図。本番を見るだけなので書かない（送らない）
# SOCKET_BROADCAST_FUNCTION_NAME=
# SOCKET_BROADCAST_LAMBDA_ENDPOINT=

# COGNITO_* は使っていないので書かない
