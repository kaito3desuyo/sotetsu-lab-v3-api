{
    "name": "sotetsu-lab-v3-api",
    "version": "4.1.1",
    "description": "",
    "author": "kaito3desuyo",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "preinstall": "typesync || :",
        "postinstall": "patch-package",
        "nest": "node --max_old_space_size=4096 ./node_modules/.bin/nest",
        "prebuild": "rimraf dist",
        "build": "npm run nest -- build",
        "postbuild": "node -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({ type: 'module' }) + '\\n')\"",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "npm run nest -- start",
        "start:dev": "npm run nest -- start --watch",
        "start:debug": "npm run nest -- start --debug --watch",
        "start:prod": "node dist/main.js",
        "deploy": "npm run build && serverless deploy",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config vitest.config.e2e.ts",
        "copy-secrets": "mkdir dist && cp -rv src/secrets dist/secrets/",
        "dotenv": "dotenvx run --env-file=.env.local --",
        "typeorm": "node --import @swc-node/register/esm-register ./node_modules/typeorm/cli.js",
        "migration:create": "npm run dotenv -- npm run typeorm -- migration:create",
        "migration:generate": "npm run dotenv -- npm run typeorm -- migration:generate -d src/core/utils/data-source.ts",
        "migration:run": "npm run dotenv -- npm run typeorm -- migration:run -d src/core/utils/data-source.ts",
        "migration:revert": "npm run dotenv -- npm run typeorm -- migration:revert -d src/core/utils/data-source.ts",
        "cli": "npm run dotenv -- node --import @swc-node/register/esm-register src/cli.ts",
        "seed:calendar-dates:holidays": "npm run dotenv -- node --import @swc-node/register/esm-register db/seeds/seed-calendar-dates-holidays.ts",
        "seed:calendar-dates:special": "npm run dotenv -- node --import @swc-node/register/esm-register db/seeds/seed-calendar-dates-special.ts",
        "seed:calendar-dates:newyear": "npm run dotenv -- node --import @swc-node/register/esm-register db/seeds/seed-calendar-dates-newyear.ts"
    },
    "dependencies": {
        "@aws-sdk/client-lambda": "^3.1156.0",
        "@nestjs/common": "^12.2.0",
        "@nestjs/core": "^12.2.0",
        "@nestjs/platform-express": "^12.2.0",
        "@nestjs/typeorm": "^12.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "compression": "^1.8.2",
        "dayjs": "^1.11.23",
        "helmet": "^8.3.0",
        "jose": "^6.2.13",
        "just-clone": "^6.2.0",
        "just-omit": "^2.2.0",
        "just-pick": "^4.2.0",
        "nest-commander": "^3.21.0",
        "nestjs-pino": "^5.3.1",
        "on-headers": "^1.1.0",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "pluralize": "^8.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ts-custom-error": "^3.3.1",
        "typeorm": "^1.1.2",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^2.38.2",
        "@nestjs/cli": "^12.0.10",
        "@nestjs/schematics": "^12.0.10",
        "@nestjs/testing": "^12.2.0",
        "@serverless/typescript": "^4.30.0",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.18",
        "@types/compression": "^1.8.1",
        "@types/express": "^5",
        "@types/node": "^24",
        "@types/on-headers": "^1.0.4",
        "@types/pg": "^8.23.1",
        "@types/pluralize": "^0.0.33",
        "@types/serverless": "^3.12.28",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "osls": "^3.78.0",
        "patch-package": "^8.0.1",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "serverless-deployment-bucket": "^1.6.0",
        "serverless-layers": "2.7.0",
        "serverless-plugin-warmup": "^8.4.1",
        "supertest": "^7.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "typesync": "^0.14.3",
        "unplugin-swc": "^2.0.0",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "nest-commander": {
            "@golevelup/nestjs-discovery": "7.1.0"
        }
    }
}
