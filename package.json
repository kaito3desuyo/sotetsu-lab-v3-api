{
    "name": "sotetsu-lab-v3-api",
    "version": "4.0.0",
    "description": "",
    "author": "kaito3desuyo",
    "license": "MIT",
    "scripts": {
        "preinstall": "typesync || :",
        "postinstall": "patch-package",
        "nest": "node --max_old_space_size=4096 ./node_modules/.bin/nest",
        "prebuild": "rimraf dist",
        "build": "npm run nest -- build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "npm run nest -- start",
        "start:dev": "npm run nest -- start --watch",
        "start:debug": "npm run nest -- start --debug --watch",
        "start:prod": "node dist/main.js",
        "deploy": "npm run build && serverless deploy",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk node_modules/.bin/jest --runInBand",
        "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
        "copy-secrets": "mkdir dist && cp -rv src/secrets dist/secrets/",
        "dotenv": "dotenvx run --env-file=.env.local --",
        "typeorm": "node -r @swc-node/register ./node_modules/typeorm/cli.js",
        "migration:create": "npm run dotenv -- npm run typeorm -- migration:create",
        "migration:generate": "npm run dotenv -- npm run typeorm -- migration:generate -d src/core/utils/data-source.ts",
        "migration:run": "npm run dotenv -- npm run typeorm -- migration:run -d src/core/utils/data-source.ts",
        "migration:revert": "npm run dotenv -- npm run typeorm -- migration:revert -d src/core/utils/data-source.ts",
        "cli": "npm run dotenv -- node -r @swc-node/register src/cli.ts",
        "seed:calendar-dates:holidays": "npm run dotenv -- node -r @swc-node/register db/seeds/seed-calendar-dates-holidays.ts",
        "seed:calendar-dates:special": "npm run dotenv -- node -r @swc-node/register db/seeds/seed-calendar-dates-special.ts",
        "seed:calendar-dates:newyear": "npm run dotenv -- node -r @swc-node/register db/seeds/seed-calendar-dates-newyear.ts"
    },
    "dependencies": {
        "@nestjs/common": "^12.2.0",
        "@nestjs/core": "^12.2.0",
        "@nestjs/platform-express": "^12.2.0",
        "@nestjs/typeorm": "^12.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "compression": "^1.7.4",
        "dayjs": "^1.11.12",
        "helmet": "^5.1.1",
        "jose": "^6.2.12",
        "just-clone": "^6.2.0",
        "just-omit": "^2.2.0",
        "just-pick": "^4.2.0",
        "lodash": "^4.17.21",
        "nest-commander": "^3.21.0",
        "nestjs-pino": "^5.3.1",
        "on-headers": "^1.1.0",
        "pg": "^8.12.0",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "pluralize": "^8.0.0",
        "reflect-metadata": "^0.1.12",
        "rxjs": "^7.8.2",
        "ts-custom-error": "^3.3.1",
        "typeorm": "^0.3.20",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^1.24.5",
        "@nestjs/cli": "^12.0.10",
        "@nestjs/schematics": "^12.0.10",
        "@nestjs/testing": "^12.2.0",
        "@serverless/typescript": "^4.27.1",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.18",
        "@types/compression": "^1.7.5",
        "@types/eslint": "^9.6.0",
        "@types/eslint-config-prettier": "^6.11.3",
        "@types/express": "^5",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.7",
        "@types/node": "^24",
        "@types/on-headers": "^1.0.4",
        "@types/pg": "^8.11.6",
        "@types/pluralize": "^0.0.33",
        "@types/prettier": "^2.7.3",
        "@types/serverless": "^3.12.22",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.1.0",
        "@typescript-eslint/parser": "^8.1.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^8.10.0",
        "jest": "^30.5.2",
        "osls": "^3.61.1",
        "patch-package": "^8.0.1",
        "pino-pretty": "^11.2.2",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.1",
        "serverless-deployment-bucket": "^1.6.0",
        "serverless-layers": "^2.7.0",
        "serverless-plugin-warmup": "^8.3.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.4.15",
        "typescript": "~6.0.3",
        "typesync": "^0.13.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "globalSetup": "<rootDir>/test-setup.ts",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "overrides": {
        "nest-commander": {
            "@golevelup/nestjs-discovery": "7.1.0"
        }
    }
}
